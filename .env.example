# ── LLM Provider ─────────────────────────────────────────────────────────────
# Google Gemini API key (required)
GOOGLE_API_KEY=your-key-here

# Model selection (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# ── Hard Budgets (per incident) ─────────────────────────────────────────────
MAX_LLM_CALLS=15
MAX_PROMPT_TOKENS=100000
MAX_COMPLETION_TOKENS=20000

# ── Victim Repo ──────────────────────────────────────────────────────────────
# Path to the victim FastAPI app (default: ../autoremediate-victim)
# VICTIM_REPO=../autoremediate-victim
